# Public frontend configuration only. Never put secrets in REACT_APP_* variables.
REACT_APP_API_URL=
REACT_APP_API_TIMEOUT_MS=12000
REACT_APP_ENV=development

# Server-only Vercel Function configuration. Never prefix secrets with REACT_APP_.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_ORIGIN=https://geniq-system.ru
